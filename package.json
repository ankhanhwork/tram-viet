{
  "name": "tram-viet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts eslint.config.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
